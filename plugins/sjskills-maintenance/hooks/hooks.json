{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'scripts/session-start.cjs')).main()\"",
            "timeout": 40,
            "statusMessage": "Checking sjskills status",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand JgAgAG4AbwBkAGUAIAAoAEoAbwBpAG4ALQBQAGEAdABoACAAJABlAG4AdgA6AFAATABVAEcASQBOAF8AUgBPAE8AVAAgACcAcwBjAHIAaQBwAHQAcwAvAHMAZQBzAHMAaQBvAG4ALQBzAHQAYQByAHQALgBjAGoAcwAnACkA"
          }
        ]
      }
    ]
  }
}
