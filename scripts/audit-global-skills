#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const crypto = require("node:crypto");
const { execFileSync } = require("node:child_process");
const {
  DEFAULT_ROOT_POLICY,
  TREE_HASH_ALGORITHM,
  assertModeledDirectory,
  assertMutationPathWithin,
  expectedGlobalPlacements,
  hashSkillDirectory,
  inspectSkillRoots,
  pathEntryExists,
  planGlobalSkillOperations,
  quarantinePlannedEntries,
  quarantineVerifiedDuplicates,
  reconcileGlobalSkillState,
  restoreQuarantine,
  writeReconcilerState
} = require("./lib/global-skill-state");
const { globalSkillEntries, readSkillRegistry } = require("./lib/skill-registry");

const repositoryRoot = path.resolve(__dirname, "..");
const defaultRegistry = path.join(repositoryRoot, "skill-registry.json");

function usage(output = console.log) {
  output(`Usage:
  scripts/audit-global-skills --profile <dev|kicpa> [--registry <path>] [--home <path>]
  scripts/audit-global-skills --profile <dev|kicpa> --apply [--registry <path>] [--home <path>]
  scripts/audit-global-skills --profile <dev|kicpa> --replace-unverified <sha256:digest> --yes [--registry <path>] [--home <path>]
  scripts/audit-global-skills --profile <dev|kicpa> --prune <sha256:digest> --yes [--registry <path>] [--home <path>]
  scripts/audit-global-skills --restore <manifest.json> --yes [--home <path>]

The default mode materializes desired remote skills in a temporary home, then audits
the selected profile's exact managed and known legacy roots without mutating the
inspected home. --apply installs or updates unambiguous Skills CLI entries and
records verified tree hashes for safe future updates. --prune moves verified
legacy duplicates into a recoverable quarantine and never removes modified,
unknown, or ambiguous entries. The read-only report prints exact approval
digests for prune and replace-unverified; mutation refuses a changed candidate
set. Replace-unverified first quarantines each approved stale copy whose prior
hash cannot be verified, then installs and verifies the same staged remote snapshot.
Restore refuses to overwrite.`);
}

function parseArgs(argv) {
  const options = {
    registry: defaultRegistry,
    profile: null,
    homeDir: os.homedir(),
    apply: false,
    replaceUnverified: false,
    prune: false,
    restore: null,
    yes: false,
    help: false
  };

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--help" || arg === "-h") {
      options.help = true;
      continue;
    }
    if (arg === "--apply") {
      options.apply = true;
      continue;
    }
    if (arg === "--prune" || arg === "--replace-unverified") {
      const value = argv[index + 1];
      if (!value || value.startsWith("--")) throw new Error(`${arg} requires a plan digest`);
      if (!/^sha256:[a-f0-9]{64}$/.test(value)) {
        throw new Error(`${arg} requires the sha256 plan digest printed by the read-only audit`);
      }
      if (arg === "--prune") options.prune = value;
      if (arg === "--replace-unverified") options.replaceUnverified = value;
      index += 1;
      continue;
    }
    if (arg === "--yes" || arg === "-y") {
      options.yes = true;
      continue;
    }
    if (["--profile", "--registry", "--home", "--restore"].includes(arg)) {
      const value = argv[index + 1];
      if (!value || value.startsWith("--")) throw new Error(`${arg} requires a value`);
      if (arg === "--profile") options.profile = value;
      if (arg === "--registry") options.registry = path.resolve(value);
      if (arg === "--home") options.homeDir = path.resolve(value);
      if (arg === "--restore") options.restore = path.resolve(value);
      index += 1;
      continue;
    }
    throw new Error(`unknown argument: ${arg}`);
  }

  if (options.help) return options;
  if ([options.apply, options.prune, options.replaceUnverified].filter(Boolean).length > 1) {
    throw new Error("--apply, --prune, and --replace-unverified are separate operations");
  }
  if (options.restore && (options.apply || options.prune || options.replaceUnverified || options.profile)) {
    throw new Error("--restore cannot be combined with a profile operation");
  }
  if (options.restore) {
    if (!options.yes) throw new Error("--restore requires --yes because it moves quarantined entries");
    return options;
  }
  if (!options.profile) throw new Error("--profile is required; expected dev or kicpa");
  if (options.prune && !options.yes) {
    throw new Error("--prune requires --yes after approving the exact read-only plan digest");
  }
  if (options.replaceUnverified && !options.yes) {
    throw new Error("--replace-unverified requires --yes after approving the exact read-only plan digest");
  }
  if (options.yes && !options.prune && !options.replaceUnverified) {
    throw new Error("--yes is only valid with --prune, --replace-unverified, or --restore");
  }
  return options;
}

function publishedSkillNames() {
  return fs
    .readdirSync(path.join(repositoryRoot, "skills"), { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name);
}

function assertRemoteSource(source) {
  if (typeof source !== "string" || source.length === 0) {
    throw new Error("Skills CLI source must be a non-empty remote reference");
  }
  if (source.startsWith(".") || source.startsWith("/") || source.startsWith("~")) {
    throw new Error("Skills CLI source must be remote, not a local path");
  }
  if (/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+(?:\/[A-Za-z0-9_.\/-]+)?$/.test(source)) {
    const segments = source.split("/");
    if (!segments.some((segment) => segment === "." || segment === ".." || segment === "")) return;
  }
  let parsed;
  try {
    parsed = new URL(source);
  } catch {
    throw new Error("Skills CLI source must be a credential-free public remote reference");
  }
  if (
    parsed.protocol !== "https:" ||
    parsed.username ||
    parsed.password ||
    parsed.search ||
    parsed.hash
  ) {
    throw new Error("Skills CLI source must be a credential-free public remote reference");
  }
}

function skillsCliAddArgs(operation) {
  assertRemoteSource(operation.source);
  if (!new Set(["codex", "claude-code"]).has(operation.targetAgent)) {
    throw new Error(`unsupported global install target: ${operation.targetAgent}`);
  }
  const args = [
    "skills",
    "add",
    operation.source,
    "--skill",
    operation.skill,
    "--copy",
    "--global",
    "--agent",
    operation.targetAgent,
    "--yes"
  ];
  if (operation.fullDepth) args.push("--full-depth");
  return args;
}

function skillsCliEnvironment(homeDir, targetAgent, baseEnvironment = process.env) {
  const environment = { ...baseEnvironment, HOME: homeDir };
  if (targetAgent === "codex") {
    // Pin the current Skills CLI default so Codex and Pi share ~/.agents/skills.
    environment.CODEX_HOME = path.join(homeDir, ".agents");
  } else if (targetAgent === "claude-code") {
    environment.CLAUDE_CONFIG_DIR = path.join(homeDir, ".claude");
  }
  return environment;
}

function placementPath(homeDir, placement) {
  const relativeRoot = placement.root === "shared" ? ".agents/skills" : ".claude/skills";
  return path.join(homeDir, relativeRoot, placement.skill);
}

function defaultExecSkillsCli({ args, homeDir, targetAgent }) {
  return execFileSync("bunx", args, {
    encoding: "utf8",
    env: skillsCliEnvironment(homeDir, targetAgent),
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 120_000,
    maxBuffer: 16 * 1024 * 1024
  });
}

function materializeExpectedSnapshot({ desiredEntries, execSkillsCli = defaultExecSkillsCli }) {
  const temporaryHome = fs.mkdtempSync(path.join(os.tmpdir(), "global-skill-expected-"));
  const expectedContent = {};
  const stagedSkills = {};
  try {
    const placements = expectedGlobalPlacements(desiredEntries);
    for (const entry of desiredEntries) {
      if (entry.manager !== "skills-cli") continue;
      const placement = placements.find(({ skill }) => skill === entry.name);
      if (!placement) throw new Error(`Skills CLI entry has no supported target: ${entry.name}`);
      const operation = { ...placement, source: entry.source };
      execSkillsCli({
        args: skillsCliAddArgs(operation),
        homeDir: temporaryHome,
        targetAgent: placement.targetAgent,
        operation
      });
      const installedPath = placementPath(temporaryHome, placement);
      if (!fs.existsSync(installedPath)) {
        throw new Error(`Skills CLI did not materialize ${entry.name} at ${installedPath}`);
      }
      expectedContent[entry.name] = hashSkillDirectory(installedPath);
      stagedSkills[entry.name] = installedPath;
    }
    let cleaned = false;
    return {
      expectedContent,
      stagedSkills,
      cleanup() {
        if (cleaned) return;
        cleaned = true;
        fs.rmSync(temporaryHome, { recursive: true, force: true });
      }
    };
  } catch (error) {
    fs.rmSync(temporaryHome, { recursive: true, force: true });
    throw error;
  }
}

function materializeExpectedContent(options) {
  const snapshot = materializeExpectedSnapshot(options);
  try {
    return snapshot.expectedContent;
  } finally {
    snapshot.cleanup();
  }
}

function installStagedOperation({ operation, stagedPath, expected, homeDir }) {
  if (operation.type !== "install") {
    throw new Error(`staged apply requires an absent target: ${operation.targetPath}`);
  }
  const target = operation.targetPath;
  const rootPath = path.dirname(target);
  fs.mkdirSync(rootPath, { recursive: true });
  assertModeledDirectory({
    directory: rootPath,
    homeDir,
    label: "apply root",
    expectedCanonicalPath: operation.expectedRootCanonicalPath
  });
  const preparedParent = fs.mkdtempSync(
    path.join(rootPath, `.${operation.skill}.installing-`)
  );
  const prepared = path.join(preparedParent, operation.skill);
  let installed = false;
  try {
    assertMutationPathWithin(preparedParent, homeDir, "prepared apply parent");
    assertMutationPathWithin(prepared, homeDir, "prepared apply target");
    fs.cpSync(stagedPath, prepared, {
      recursive: true,
      force: false,
      errorOnExist: true,
      preserveTimestamps: true,
      verbatimSymlinks: true
    });
    const preparedHash = hashSkillDirectory(prepared);
    if (
      !expected ||
      preparedHash.hashAlgorithm !== expected.hashAlgorithm ||
      preparedHash.hash !== expected.hash
    ) {
      throw new Error(`staged content verification failed for ${operation.skill}`);
    }
    assertModeledDirectory({
      directory: rootPath,
      homeDir,
      label: "apply root",
      expectedCanonicalPath: operation.expectedRootCanonicalPath
    });
    if (pathEntryExists(target)) {
      throw new Error(`apply install target appeared after staging: ${target}`);
    }
    fs.renameSync(prepared, target);
    installed = true;
    const installedHash = hashSkillDirectory(target);
    if (
      installedHash.hashAlgorithm !== expected.hashAlgorithm ||
      installedHash.hash !== expected.hash
    ) {
      throw new Error(`apply verification failed for ${operation.skill} in ${operation.root}`);
    }
  } catch (error) {
    if (installed && pathEntryExists(target)) {
      assertMutationPathWithin(target, homeDir, "failed staged apply target");
      fs.rmSync(target, { recursive: true, force: true });
    }
    throw error;
  } finally {
    assertMutationPathWithin(preparedParent, homeDir, "prepared apply parent");
    fs.rmSync(preparedParent, { recursive: true, force: true });
  }
}

function executeApplyOperations({
  operations,
  expectedContent,
  homeDir,
  execSkillsCli,
  stagedSkills = null
}) {
  for (const operation of operations) {
    const target = placementPath(homeDir, operation);
    if (operation.targetPath !== target) {
      throw new Error(`apply target does not match the modeled root: ${operation.targetPath}`);
    }
    const rootPath = path.dirname(target);
    if (operation.modeledRootPath && operation.modeledRootPath !== rootPath) {
      throw new Error(`apply operation modeled root changed: ${operation.modeledRootPath}`);
    }
    assertMutationPathWithin(rootPath, homeDir, "apply root");
    assertMutationPathWithin(target, homeDir, "apply target");
    assertModeledDirectory({
      directory: rootPath,
      homeDir,
      label: "apply root",
      allowMissing: true,
      expectedCanonicalPath: operation.expectedRootCanonicalPath
    });
    if (operation.type === "install" && pathEntryExists(target)) {
      throw new Error(`apply install target appeared after planning: ${target}`);
    }
    if (operation.type === "update") {
      if (!pathEntryExists(target)) throw new Error(`apply update target disappeared: ${target}`);
      const current = hashSkillDirectory(target);
      if (
        operation.expectedCurrentKind !== "directory" ||
        current.hashAlgorithm !== operation.expectedCurrentHashAlgorithm ||
        current.hash !== operation.expectedCurrentHash
      ) {
        throw new Error(`apply update target changed after planning: ${target}`);
      }
    }
    const expected = expectedContent[operation.skill];
    if (stagedSkills) {
      const stagedPath = stagedSkills[operation.skill];
      if (!stagedPath) throw new Error(`missing staged content for ${operation.skill}`);
      installStagedOperation({ operation, stagedPath, expected, homeDir });
    } else {
      execSkillsCli({
        args: skillsCliAddArgs(operation),
        homeDir,
        targetAgent: operation.targetAgent,
        operation
      });
    }
    assertMutationPathWithin(rootPath, homeDir, "apply root");
    assertMutationPathWithin(target, homeDir, "apply target");
    assertModeledDirectory({
      directory: rootPath,
      homeDir,
      label: "apply root",
      expectedCanonicalPath: operation.expectedRootCanonicalPath
    });
    if (!pathEntryExists(target)) throw new Error(`apply did not create expected target: ${target}`);
    const installed = hashSkillDirectory(target);
    if (!expected || installed.hashAlgorithm !== expected.hashAlgorithm || installed.hash !== expected.hash) {
      throw new Error(`apply verification failed for ${operation.skill} in ${operation.root}`);
    }
  }
}

function strictIssues(report) {
  return report.issues.filter(({ type }) => type !== "protected");
}

function shellQuote(value) {
  return `'${String(value).replace(/'/g, `'\\''`)}'`;
}

function formatApplyOperation(operation) {
  return [
    `${operation.type} ${operation.skill} @ ${operation.root}`,
    `from ${operation.source}`,
    `via temporary ${operation.targetAgent} snapshot`,
    `-> ${operation.targetPath}`
  ].join(" ");
}

function quarantinePlanDigest(kind, operations) {
  if (!new Set(["prune", "replace-unverified"]).has(kind)) {
    throw new Error(`unsupported quarantine plan kind: ${kind}`);
  }
  const candidates = operations.map((operation) => ({
    type: operation.type,
    skill: operation.skill,
    root: operation.root,
    from: operation.from,
    expectedKind: operation.expectedKind,
    expectedHashAlgorithm: operation.expectedHashAlgorithm,
    expectedHash: operation.expectedHash,
    expectedResolvedTarget: operation.expectedResolvedTarget ?? null,
    modeledRootPath: operation.modeledRootPath,
    expectedRootCanonicalPath: operation.expectedRootCanonicalPath,
    canonicalPath: operation.canonicalPath ?? null,
    canonicalRootPath: operation.canonicalRootPath ?? null,
    expectedCanonicalRootCanonicalPath: operation.expectedCanonicalRootCanonicalPath ?? null,
    expectedCanonicalHashAlgorithm: operation.expectedCanonicalHashAlgorithm ?? null,
    expectedCanonicalHash: operation.expectedCanonicalHash ?? null,
    source: operation.source ?? null,
    targetAgent: operation.targetAgent ?? null,
    fullDepth: operation.fullDepth ?? null,
    replacementHashAlgorithm: operation.replacementHashAlgorithm ?? null,
    replacementHash: operation.replacementHash ?? null
  })).sort((left, right) => JSON.stringify(left).localeCompare(JSON.stringify(right)));
  const hash = crypto.createHash("sha256");
  hash.update(JSON.stringify({ version: 1, kind, candidates }));
  return `sha256:${hash.digest("hex")}`;
}

function approvedQuarantineCommand({ mode, digest, profile, registryPath, homeDir }) {
  const parts = [
    "scripts/audit-global-skills",
    "--profile",
    shellQuote(profile),
    `--${mode}`,
    shellQuote(digest)
  ];
  if (path.resolve(registryPath) !== defaultRegistry) {
    parts.push("--registry", shellQuote(registryPath));
  }
  parts.push("--home", shellQuote(homeDir), "--yes");
  return parts.join(" ");
}

function printReport({ registry, registryPath, profile, report, operations, quarantineRoot, output }) {
  output(`Registry: ${path.relative(repositoryRoot, registryPath) || registryPath}`);
  output(`Profile: ${profile}`);
  output(`Audiences: ${registry.global.profiles[profile].audiences.join(", ")}`);
  output("Modeled roots:");
  for (const root of report.inventory.roots) {
    output(`- ${root.id}: ${root.kind} ${root.path}`);
  }
  output("Expected skills by managed root:");
  for (const rootId of ["shared", "claude"]) {
    const names = report.placements
      .filter(({ root }) => root === rootId)
      .map(({ skill }) => skill);
    output(`- ${rootId} (${names.length}): ${names.join(", ") || "none"}`);
  }

  if (report.issues.length === 0) {
    output("Discrepancies: none");
  } else {
    output("Discrepancies:");
    for (const issue of report.issues) {
      output(
        `- ${issue.type}: ${issue.skill ?? "(root)"} @ ${issue.root} (${issue.reason})${
          issue.path ? ` ${issue.path}` : ""
        }`
      );
    }
  }

  output("Proposed apply operations:");
  if (operations.apply.length === 0) output("- none");
  for (const operation of operations.apply) {
    output(`- ${formatApplyOperation(operation)}`);
  }
  output("Manual manager actions:");
  if (operations.manual.length === 0) output("- none");
  for (const operation of operations.manual) {
    output(`- ${operation.skill} @ ${operation.root}: ${operation.manager} (${operation.issue})`);
  }
  output("Proposed prune operations:");
  if (operations.prune.length === 0) output("- none");
  for (const operation of operations.prune) output(`- move ${operation.from} -> ${operation.to}`);
  if (operations.prune.length > 0) {
    const digest = quarantinePlanDigest("prune", operations.prune);
    output(`Prune approval digest: ${digest}`);
    output(`Approved prune command: ${approvedQuarantineCommand({
      mode: "prune",
      digest,
      profile,
      registryPath,
      homeDir: report.inventory.homeDir
    })}`);
    output("The digest binds approval to this exact source state; execution allocates a fresh run destination and revalidates each entry.");
    output(`Quarantine: ${quarantineRoot}`);
    output(
      `Restore after pruning: scripts/audit-global-skills --restore ${shellQuote(
        path.join(quarantineRoot, "manifest.json")
      )} --home ${shellQuote(report.inventory.homeDir)} --yes`
    );
  }
  output("Proposed recoverable replacements:");
  if (operations.replace.length === 0) output("- none");
  for (const operation of operations.replace) {
    output(`- quarantine ${operation.from} -> ${operation.to}, then install the verified staged snapshot from ${operation.source}`);
  }
  if (operations.replace.length > 0) {
    const digest = quarantinePlanDigest("replace-unverified", operations.replace);
    output(`Replacement approval digest: ${digest}`);
    output(`Approved replacement command: ${approvedQuarantineCommand({
      mode: "replace-unverified",
      digest,
      profile,
      registryPath,
      homeDir: report.inventory.homeDir
    })}`);
    output("The digest binds approval to this exact source state; every original copy remains in the manifest-backed quarantine.");
    output(`Quarantine: ${quarantineRoot}`);
    output(
      `Restore after replacement: scripts/audit-global-skills --restore ${shellQuote(
        path.join(quarantineRoot, "manifest.json")
      )} --home ${shellQuote(report.inventory.homeDir)} --yes`
    );
  }
  output(`Strict result: ${strictIssues(report).length === 0 ? "pass" : "fail"}`);
}

function timestampForPath(date) {
  return date.toISOString().replace(/[:.]/g, "-");
}

function buildReport({ desiredEntries, knownSkillNames, expectedContent, homeDir, rootPolicy }) {
  const inventory = inspectSkillRoots({ homeDir, rootPolicy });
  return reconcileGlobalSkillState({
    desiredEntries,
    knownSkillNames,
    expectedContent,
    inventory
  });
}

function managedStateRecordsForExactPlacements({ report, expectedContent, recordedAt }) {
  const records = new Map(
    (report.inventory.reconcilerState ?? []).map((record) => [
      `${record.root}\0${record.skill}`,
      record
    ])
  );
  const entries = new Map(
    report.inventory.entries.map((entry) => [`${entry.root}\0${entry.name}`, entry])
  );
  for (const placement of report.placements) {
    if (placement.manager !== "skills-cli") continue;
    const key = `${placement.root}\0${placement.skill}`;
    const current = entries.get(key);
    const expected = expectedContent[placement.skill];
    if (
      current?.kind === "directory" &&
      current.hashStatus === "verified" &&
      current.hashAlgorithm === TREE_HASH_ALGORITHM &&
      expected?.hashAlgorithm === TREE_HASH_ALGORITHM &&
      current.hash === expected.hash
    ) {
      records.set(key, {
        root: placement.root,
        skill: placement.skill,
        source: placement.source,
        hashAlgorithm: current.hashAlgorithm,
        hash: current.hash,
        recordedAt
      });
    }
  }
  return [...records.values()].sort((left, right) =>
    `${left.root}\0${left.skill}`.localeCompare(`${right.root}\0${right.skill}`)
  );
}

function applyOperationsForReplacements(operations) {
  return operations.map((operation) => ({
    type: "install",
    skill: operation.skill,
    source: operation.source,
    sourceId: operation.sourceId,
    root: operation.root,
    targetAgent: operation.targetAgent,
    fullDepth: operation.fullDepth,
    targetPath: operation.from,
    modeledRootPath: operation.modeledRootPath,
    expectedRootCanonicalPath: operation.expectedRootCanonicalPath,
    expectedCurrentKind: null,
    expectedCurrentHashAlgorithm: null,
    expectedCurrentHash: null
  }));
}

function bindReplacementExpectedContent(operations, expectedContent) {
  return {
    ...operations,
    replace: operations.replace.map((operation) => {
      const expected = expectedContent[operation.skill];
      if (!expected?.hashAlgorithm || !expected.hash) {
        throw new Error(`replacement expected content is unverifiable: ${operation.skill}`);
      }
      return {
        ...operation,
        replacementHashAlgorithm: expected.hashAlgorithm,
        replacementHash: expected.hash
      };
    })
  };
}

function quarantineOperationsForUpdates(operations, quarantineRoot) {
  return operations.filter(({ type }) => type === "update").map((operation) => ({
    type: "quarantine-update",
    skill: operation.skill,
    root: operation.root,
    from: operation.targetPath,
    to: path.join(quarantineRoot, operation.root, operation.skill),
    mustNotExist: true,
    expectedKind: operation.expectedCurrentKind,
    expectedHashAlgorithm: operation.expectedCurrentHashAlgorithm,
    expectedHash: operation.expectedCurrentHash,
    expectedResolvedTarget: null,
    modeledRootPath: operation.modeledRootPath,
    expectedRootCanonicalPath: operation.expectedRootCanonicalPath
  }));
}

function applyOperationsAfterUpdateQuarantine(operations) {
  return operations.map((operation) => operation.type !== "update" ? operation : ({
    ...operation,
    type: "install",
    expectedCurrentKind: null,
    expectedCurrentHashAlgorithm: null,
    expectedCurrentHash: null
  }));
}

function run(options, dependencies = {}) {
  const output = dependencies.output ?? console.log;
  const execSkillsCli = dependencies.execSkillsCli ?? defaultExecSkillsCli;
  const rootPolicy = dependencies.rootPolicy ?? DEFAULT_ROOT_POLICY;
  const now = dependencies.now ?? (() => new Date());

  if (path.resolve(options.homeDir) === path.parse(path.resolve(options.homeDir)).root) {
    throw new Error("homeDir must not be a filesystem root");
  }

  if (options.restore) {
    const result = restoreQuarantine({ manifestPath: options.restore, homeDir: options.homeDir });
    output(`Restored entries: ${result.restored.length}`);
    for (const restoredPath of result.restored) output(`- ${restoredPath}`);
    output(`Manifest updated: ${result.manifestPath}`);
    return 0;
  }

  const registry = readSkillRegistry(options.registry, {
    repositorySkillNames: dependencies.repositorySkillNames ?? publishedSkillNames()
  });
  const desiredEntries = globalSkillEntries(registry, options.profile);
  for (const entry of desiredEntries) {
    if (entry.manager === "skills-cli") assertRemoteSource(entry.source);
  }
  const knownSkillNames = registry.skills
    .filter(({ recommendation }) => recommendation.scope === "global")
    .map(({ name }) => name);
  const expectedSnapshot = dependencies.expectedContent === undefined
    ? materializeExpectedSnapshot({ desiredEntries, execSkillsCli })
    : null;
  const expectedContent = dependencies.expectedContent ?? expectedSnapshot.expectedContent;
  const stagedSkills = expectedSnapshot?.stagedSkills ?? null;
  try {
    const quarantineRoot = dependencies.quarantineRoot ?? path.join(
      options.homeDir,
      ".skill-quarantine",
      `global-skills-${timestampForPath(now())}`
    );

    let report = buildReport({
      desiredEntries,
      knownSkillNames,
      expectedContent,
      homeDir: options.homeDir,
      rootPolicy
    });
    let operations = bindReplacementExpectedContent(
      planGlobalSkillOperations({ report, quarantineRoot }),
      expectedContent
    );
    printReport({
      registry,
      registryPath: options.registry,
      profile: options.profile,
      report,
      operations,
      quarantineRoot,
      output
    });

    if (options.prune) {
      const currentDigest = quarantinePlanDigest("prune", operations.prune);
      if (options.prune !== currentDigest) {
        throw new Error(
          `prune approval digest does not match the current candidate set; rerun the read-only audit (current ${currentDigest})`
        );
      }
    }
    if (options.replaceUnverified) {
      const currentDigest = quarantinePlanDigest("replace-unverified", operations.replace);
      if (options.replaceUnverified !== currentDigest) {
        throw new Error(
          `replacement approval digest does not match the current candidate set; rerun the read-only audit (current ${currentDigest})`
        );
      }
    }

    if (
      (options.apply || options.replaceUnverified) &&
      report.inventory.errors.some(({ reason }) => reason.startsWith("reconciler-state"))
    ) {
      throw new Error("apply refuses to overwrite invalid or untrusted reconciler state");
    }

    if (options.apply && operations.apply.length > 0) {
      const updateQuarantineOperations = quarantineOperationsForUpdates(
        operations.apply,
        quarantineRoot
      );
      if (updateQuarantineOperations.length > 0) {
        const result = quarantinePlannedEntries({
          report,
          operations: updateQuarantineOperations,
          quarantineRoot,
          createdAt: now().toISOString()
        });
        output(`Quarantined verified updates: ${updateQuarantineOperations.length}`);
        output(`Restore manifest: ${result.manifestPath}`);
      }
      executeApplyOperations({
        operations: applyOperationsAfterUpdateQuarantine(operations.apply),
        expectedContent,
        homeDir: options.homeDir,
        execSkillsCli,
        stagedSkills
      });
      output(`Applied operations: ${operations.apply.length}`);
    }
    if (options.prune && operations.prune.length > 0) {
      const result = quarantineVerifiedDuplicates({
        report,
        operations: operations.prune,
        quarantineRoot,
        createdAt: now().toISOString()
      });
      output(`Quarantined entries: ${operations.prune.length}`);
      output(`Restore manifest: ${result.manifestPath}`);
    }

    if (options.replaceUnverified && operations.replace.length > 0) {
      const result = quarantinePlannedEntries({
        report,
        operations: operations.replace,
        quarantineRoot,
        createdAt: now().toISOString()
      });
      output(`Quarantined unverified entries: ${operations.replace.length}`);
      output(`Restore manifest: ${result.manifestPath}`);
      executeApplyOperations({
        operations: applyOperationsForReplacements(operations.replace),
        expectedContent,
        homeDir: options.homeDir,
        execSkillsCli,
        stagedSkills
      });
      output(`Installed verified replacements: ${operations.replace.length}`);
    }

    if (options.apply || (options.replaceUnverified && operations.replace.length > 0)) {
      const adoptionReport = buildReport({
        desiredEntries,
        knownSkillNames,
        expectedContent,
        homeDir: options.homeDir,
        rootPolicy
      });
      const records = managedStateRecordsForExactPlacements({
        report: adoptionReport,
        expectedContent,
        recordedAt: now().toISOString()
      });
      const statePath = writeReconcilerState({ homeDir: options.homeDir, records });
      output(`Recorded verified Skills CLI state: ${statePath}`);
    }

    if (options.apply || options.prune || options.replaceUnverified) {
      report = buildReport({
        desiredEntries,
        knownSkillNames,
        expectedContent,
        homeDir: options.homeDir,
        rootPolicy
      });
      operations = bindReplacementExpectedContent(
        planGlobalSkillOperations({ report, quarantineRoot }),
        expectedContent
      );
      output(`Post-operation strict result: ${strictIssues(report).length === 0 ? "pass" : "fail"}`);
    }
    return strictIssues(report).length === 0 ? 0 : 1;
  } finally {
    expectedSnapshot?.cleanup();
  }
}

function main(argv = process.argv.slice(2)) {
  try {
    const options = parseArgs(argv);
    if (options.help) {
      usage();
      return 0;
    }
    return run(options);
  } catch (error) {
    console.error(error.message);
    return 1;
  }
}

if (require.main === module) process.exitCode = main();

module.exports = {
  assertRemoteSource,
  applyOperationsForReplacements,
  executeApplyOperations,
  managedStateRecordsForExactPlacements,
  main,
  materializeExpectedContent,
  materializeExpectedSnapshot,
  parseArgs,
  quarantinePlanDigest,
  run,
  skillsCliAddArgs,
  skillsCliEnvironment,
  strictIssues
};
