#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const path = require("node:path");

const repositoryRoot = path.resolve(__dirname, "..");

function usage(output = console.log) {
  output(`Usage:
  scripts/audit-global-skills

This command is now a read-only transition wrapper for:
  bin/sjskills plan --global

Machine profiles and the legacy --apply, --prune, --replace-unverified, and
--restore interfaces are retired. Use sjskills apply --global and
sjskills restore --global <quarantine-id> after reviewing the current plan.`);
}

function main(argv, dependencies = {}) {
  const run = dependencies.spawnSync || spawnSync;
  const log = dependencies.log || console.log;
  const error = dependencies.error || console.error;
  if (argv.includes("--help") || argv.includes("-h")) {
    usage(log);
    return 0;
  }
  if (argv.length !== 0) {
    error("audit-global-skills: legacy profile and mutation arguments are retired");
    usage(error);
    return 64;
  }
  const result = run(path.join(repositoryRoot, "bin", "sjskills"), ["plan", "--global"], {
    cwd: repositoryRoot,
    env: process.env,
    stdio: "inherit"
  });
  if (result.error) {
    error("audit-global-skills: sjskills could not be started");
    return 2;
  }
  return result.status ?? 2;
}

if (require.main === module) process.exitCode = main(process.argv.slice(2));

module.exports = { main };
